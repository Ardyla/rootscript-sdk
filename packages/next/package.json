{
  "name": "@rootscript/next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next.js adapter helpers for Rootscript",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@ardyla/rootscript-core": "^0.3.1"
  }
}
